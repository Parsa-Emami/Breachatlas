{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:breachatlas:result:1",
  "title": "Evidence manifest validation result v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "status": {
          "const": "valid"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "case_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          },
          "required": [
            "case_id",
            "evidence_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "input_digest",
        "engine_version",
        "result"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_json",
                "origin_not_allowed",
                "method_not_allowed",
                "request_timeout",
                "payload_too_large",
                "unsupported_media_type",
                "invalid_manifest",
                "unexpected_or_duplicate_field",
                "invalid_field",
                "missing_field",
                "unsupported_version",
                "engine_unavailable"
              ]
            },
            "field": {
              "enum": [
                "schema_version",
                "case_id",
                "evidence_id",
                "sha256",
                "size_bytes",
                "media_type",
                "acquired_at",
                "custody_root"
              ]
            }
          },
          "required": [
            "code"
          ],
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_field",
                  "missing_field",
                  "unsupported_version"
                ]
              }
            }
          },
          "then": {
            "required": [
              "field"
            ]
          },
          "else": {
            "not": {
              "required": [
                "field"
              ]
            }
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ]
    }
  ]
}
